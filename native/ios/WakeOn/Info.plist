<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kamikaz1k.wakeon.memory</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Pixie</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pixie</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kamikaz1k.wakeon</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wakeon</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>Pixie sets the alarms and timers you ask for, so they ring even when your iPhone is locked or silenced.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Pixie reads and adds events in your calendars when you ask, like “what’s on tomorrow?” or “add lunch with Sam on Friday”.</string>
	<key>NSCameraUsageDescription</key>
	<string>Pixie doesn’t use your camera: calls with Pixie are voice only. A website you open in Pixie’s browser could ask for it, and iOS asks you first.</string>
	<key>NSContactsUsageDescription</key>
	<string>When you ask Pixie to call someone, it looks them up in your contacts. Names and number labels are used in the call; the numbers stay on your iPhone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When you ask about something near you, like the weather or places nearby, Pixie looks up your location once and uses it to answer.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Listen locally for Hey Pixie, keep a short audio buffer for the wake handoff, and talk with the voice assistant.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Pixie reads and adds your reminders when you ask, like “remind me to call Mom at 5” or “add milk to my groceries”.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>PixieCommit</key>
	<string>$(PIXIE_COMMIT)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
